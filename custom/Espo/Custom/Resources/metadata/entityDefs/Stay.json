{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "dog": {
            "type": "link",
            "required": true,
            "isCustom": true
        },
        "arrive": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "depart": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Requested",
                "Confirmed",
                "InHouse",
                "Done"
            ],
            "default": "Requested",
            "isCustom": true,
            "style": {
                "Requested": null,
                "Confirmed": "primary",
                "InHouse": "info",
                "Done": "success"
            }
        },
        "run": {
            "type": "varchar",
            "maxLength": 40,
            "isCustom": true
        },
        "feeding": {
            "type": "text",
            "isCustom": true
        },
        "service": {
            "type": "enum",
            "required": true,
            "options": [
                "Boarding",
                "BoardAndTrain",
                "DayStayAndTrain"
            ],
            "isCustom": true,
            "style": {
                "Boarding": "primary",
                "BoardAndTrain": "info",
                "DayStayAndTrain": "success"
            }
        },
        "emergencyName": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "emergencyPhone": {
            "type": "varchar",
            "maxLength": 40,
            "isCustom": true
        },
        "healthCertified": {
            "type": "bool",
            "isCustom": true
        },
        "foodSource": {
            "type": "enum",
            "options": [
                "",
                "Owner",
                "Facility"
            ],
            "isCustom": true
        },
        "medications": {
            "type": "text",
            "isCustom": true
        },
        "specialCare": {
            "type": "text",
            "isCustom": true
        },
        "nightlyRate": {
            "type": "currency",
            "default": 50,
            "isCustom": true
        },
        "discount": {
            "type": "enum",
            "options": [
                "",
                "Military",
                "FirstResponder",
                "Senior",
                "Rescue"
            ],
            "isCustom": true
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Unpaid",
                "Paid",
                "Other"
            ],
            "default": "Unpaid",
            "isCustom": true
        },
        "photoConsent": {
            "type": "bool",
            "default": true,
            "isCustom": true
        },
        "agreementAccepted": {
            "type": "bool",
            "isCustom": true
        },
        "agreementDate": {
            "type": "date",
            "isCustom": true
        },
        "dropOffTime": {
            "type": "enum",
            "options": [
                "",
                "Morning",
                "Midday",
                "Evening"
            ],
            "isCustom": true
        },
        "pickUpTime": {
            "type": "enum",
            "options": [
                "",
                "Morning",
                "Midday",
                "Evening"
            ],
            "isCustom": true
        },
        "feedingAM": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "feedingPM": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "medsAM": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "medsPM": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "careNote": {
            "type": "text",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "dog": {
            "type": "belongsTo",
            "foreign": "stays",
            "entity": "Dog",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "arrive",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
