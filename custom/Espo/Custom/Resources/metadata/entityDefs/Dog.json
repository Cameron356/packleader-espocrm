{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "breed": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "sex": {
            "type": "enum",
            "options": [
                "",
                "Female",
                "Male"
            ],
            "isCustom": true
        },
        "intact": {
            "type": "bool",
            "isCustom": true
        },
        "crateTrained": {
            "type": "bool",
            "isCustom": true
        },
        "temperament": {
            "type": "text",
            "isCustom": true
        },
        "rabiesDue": {
            "type": "date",
            "isCustom": true
        },
        "dhppDue": {
            "type": "date",
            "isCustom": true
        },
        "bordetellaDue": {
            "type": "date",
            "isCustom": true
        },
        "contact": {
            "type": "link",
            "isCustom": true
        },
        "stays": {
            "type": "linkMultiple",
            "isCustom": true
        },
        "meetings": {
            "type": "linkMultiple",
            "isCustom": true
        },
        "groupClasses": {
            "type": "linkMultiple",
            "isCustom": true
        },
        "age": {
            "type": "varchar",
            "maxLength": 40,
            "isCustom": true
        },
        "preventionCurrent": {
            "type": "bool",
            "isCustom": true
        },
        "vetClinic": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "vetName": {
            "type": "varchar",
            "maxLength": 120,
            "isCustom": true
        },
        "vetAddress": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "vetPhone": {
            "type": "varchar",
            "maxLength": 40,
            "isCustom": true
        },
        "emergencyVet": {
            "type": "varchar",
            "maxLength": 160,
            "isCustom": true
        },
        "goodWith": {
            "type": "checklist",
            "options": [
                "MaleDogs",
                "FemaleDogs",
                "LargeDogs",
                "SmallDogs",
                "Puppies",
                "Cats",
                "Children",
                "NewPeople",
                "Unknown"
            ],
            "isCustom": true
        },
        "shotRecords": {
            "type": "attachmentMultiple",
            "sourceList": [],
            "isCustom": true
        },
        "dogSize": {
            "type": "enum",
            "options": [
                "",
                "Under25",
                "From25to50",
                "From50to75",
                "From75to100",
                "Over100",
                "Over40",
                "Under40"
            ],
            "isCustom": true
        },
        "foodSource": {
            "type": "enum",
            "options": [
                "",
                "Owner",
                "Facility"
            ],
            "isCustom": true
        },
        "feeding": {
            "type": "text",
            "rows": 2,
            "isCustom": true
        },
        "medications": {
            "type": "text",
            "rows": 2,
            "isCustom": true
        },
        "specialCare": {
            "type": "text",
            "rows": 2,
            "isCustom": true
        },
        "birthDate": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "weight": {
            "type": "float",
            "isCustom": true
        },
        "weightDate": {
            "type": "date",
            "isCustom": true
        },
        "rabiesGiven": {
            "type": "date",
            "isCustom": true
        },
        "dhppGiven": {
            "type": "date",
            "isCustom": true
        },
        "bordetellaGiven": {
            "type": "date",
            "isCustom": true
        },
        "leptospirosisDue": {
            "type": "date",
            "isCustom": true
        },
        "influenzaDue": {
            "type": "date",
            "isCustom": true
        },
        "microchip": {
            "type": "varchar",
            "maxLength": 64,
            "isCustom": true
        },
        "spayNeuterDate": {
            "type": "date",
            "isCustom": true
        },
        "vetRecordDate": {
            "type": "date",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "dogs",
            "entity": "Contact",
            "isCustom": true
        },
        "stays": {
            "type": "hasMany",
            "foreign": "dog",
            "entity": "Stay",
            "isCustom": true
        },
        "meetings": {
            "type": "hasMany",
            "foreign": "dog",
            "entity": "Meeting",
            "isCustom": true
        },
        "groupClasses": {
            "type": "hasMany",
            "foreign": "dogs",
            "entity": "Meeting",
            "relationName": "groupClassDog",
            "isCustom": true
        },
        "lessonPackages": {
            "type": "hasMany",
            "entity": "LessonPackage",
            "isCustom": true,
            "foreign": "dog"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
