{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters",
            "maxLength": 80,
            "isCustom": true
        },
        "stay": {
            "type": "link",
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "NotStarted",
                "Working",
                "Solid"
            ],
            "default": "NotStarted",
            "isCustom": true
        },
        "notes": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "stay": {
            "type": "belongsTo",
            "entity": "Stay",
            "isCustom": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    }
}
